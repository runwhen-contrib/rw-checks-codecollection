{
  "$defs": {
    "Finding": {
      "description": "One static-check finding. `fingerprint` is None until\nContext.findings.fingerprint() has run over it -- see CONTRACT.md's\nfingerprint formula, ported byte-identical in findings.py.",
      "properties": {
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "line": {
          "default": 0,
          "title": "Line",
          "type": "integer"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "note"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "context": {
          "default": "",
          "title": "Context",
          "type": "string"
        }
      },
      "required": [
        "capability",
        "operation",
        "rule",
        "path",
        "severity"
      ],
      "title": "Finding",
      "type": "object"
    }
  },
  "description": "Output of a `kind: rw.findings.v1` task (ruff, gitleaks). An\nenvelope, not a bare list of Finding -- same reasoning as\nGrepResult/LsResult below: `truncated` is the only way a consumer can\ntell a capped list from a complete one. See findings.py's\nMAX_FINDINGS_PER_RESULT for the cap and the byte budget behind it.",
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "title": "FindingsResult",
  "type": "object"
}
